<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
            Prompt lab, debug builds only. Started from a computer with
            `adb shell am start -n com.mdreader/.LabActivity`. DUMP is held by the adb shell and by
            no ordinary app, so nothing else on the phone can start a run on the user's key.
        -->
        <activity
            android:name=".LabActivity"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
